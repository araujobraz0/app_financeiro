# Variáveis públicas do app Expo (podem ir para o repositório)
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_aqui

# ATENÇÃO: os valores abaixo NUNCA devem ser preenchidos neste arquivo.
